# -----------------------------------------------------------------------------
# Agent Studio OS - Environment Configuration Example
# -----------------------------------------------------------------------------
# Duplicate this file as `.env.local` and configure your local values.
# NEVER commit `.env` or `.env.local` containing actual API keys or secrets!
# -----------------------------------------------------------------------------

# OmniRoute Local Multi-Model Router
OMNIROUTE_URL="http://127.0.0.1:20128"
OMNIROUTE_API_KEY=""

# Optional Direct Provider Keys (if not routing via OmniRoute)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""

# Local Runtime Paths (Leave blank for default auto-discovery)
HERMES_HOME=""
OBSIDIAN_VAULT_PATH=""

# Web Server Port
PORT=3000
